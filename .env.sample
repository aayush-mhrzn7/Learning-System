DATABASE_URL=
AUTH_SECRET=
# 32-byte key: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
# Set to "false" to reject new account creation (403). Omit or any other value allows signup.
ALLOW_SIGNUP=

# Cloudflare R2 object storage (image uploads) - see docs/r2-setup.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=scholar
# Optional override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Email (nodemailer / SMTP). If SMTP_HOST is empty, emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Scholar <no-reply@example.com>"
# Public URL of the app, used for links in emails (e.g. https://scholar.example.com)
APP_URL=http://localhost:3000
